# Server Configuration
PORT=8080

# Database Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=chat_app

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=chat_app

# JWT Configuration
# ZORUNLU: Güçlü, rastgele bir secret belirleyin. Boş veya varsayılan bırakılamaz.
# Üretmek için: openssl rand -hex 32
JWT_SECRET=BURAYA_GUCLU_RASTGELE_BIR_SECRET_YAZIN
JWT_EXPIRATION=24h

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# CORS Configuration (Railway'da front-end URL'inizi ekleyin)
# Comma-separated: https://www.fridpass.com,https://fridpass.com,http://localhost:3000
# ÖNEMLİ: www.fridpass.com ve fridpass.com her ikisini de ekleyin
CORS_ALLOWED_ORIGINS=https://www.fridpass.com,https://fridpass.com,http://localhost:3000

# Redis Configuration (Optional)
# Set REDIS_ENABLED=false to disable Redis completely
# If Redis is not available, the app will continue without it (with limited features)
REDIS_ENABLED=true

# Twilio SMS Configuration (for verification codes)
# Get these from https://console.twilio.com/
TWILIO_ENABLED=true
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
